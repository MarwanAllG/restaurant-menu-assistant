# OpenRouter: use a key with credits and access to this model.
OPENROUTER_API_KEY=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=deepseek/deepseek-v4.1-flash
MODEL_TIMEOUT_SECONDS=60
# Output cap; the adapter sends max_tokens. OpenRouter routes only to capable endpoints.
MODEL_MAX_TOKENS=4096
MODEL_REASONING_EFFORT=none
# Generate once, keep stable across restarts: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=
# Generate a private JSON mapping with scripts/configure_accounts.py.
# Example shape only: {"Marwan":"pbkdf2_sha256$600000$...$...", "Toka":"..."}
TEST_ACCOUNTS_JSON=
# One process / one persistent local disk. On Render use /data.
DATA_DIR=./data
# Set your deployed HTTPS origin/custom domain (Render detects its own URL).
APP_URL=
# Local HTTP: lax. For HTTPS deployment set none (Chainlit also enables Secure).
CHAINLIT_COOKIE_SAMESITE=lax
# Opt-in live scenarios use the selected provider and may incur API charges.
RUN_LIVE_TESTS=0
